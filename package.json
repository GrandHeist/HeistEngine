{
  "name": "heist-engine",
  "version": "0.1.0",
  "description": "Drop-in economy engine for GTA RP servers with a swappable ledger backend and a server-configurable currency (default placeholder: HD).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "sim": "node src/cli/sim.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": ["gta", "fivem", "ragemp", "roleplay", "economy", "ledger"],
  "license": "MIT",
  "dependencies": {},
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0"
  }
}
